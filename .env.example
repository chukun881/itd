# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Login (no sign-up; create users with: node scripts/create-user.mjs you@example.com)
# Signs the session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=xxx

# Cloudflare R2 (private bucket; files are served with presigned URLs)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=image-to-3d

# fal.ai (server-side only)
FAL_KEY=xxx

# Access and limits
ADMIN_EMAILS=you@example.com
MONTHLY_JOB_CAP=40

NEXT_PUBLIC_APP_URL=http://localhost:3001
