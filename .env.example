# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Auth (sign-up disabled in the Clerk dashboard; users created by the admin)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Cloudflare R2 (private bucket; files are served with presigned URLs)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=image-to-3d
R2_PUBLIC_URL=https://models.yourdomain.com

# fal.ai (server-side only)
FAL_KEY=xxx

NEXT_PUBLIC_APP_URL=http://localhost:3001
